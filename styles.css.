body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background-color: #f5f5f5;
}

header, footer {
    background: #333;
    color: white;
    text-align: center;
    padding: 15px 0;
}

nav ul {
    display: flex;
    justify-content: center;
    list-style: none;
    padding: 0;
}

nav ul li {
    margin: 0 15px;
}

nav ul li a {
    color: white;
    text-decoration: none;
}

.filters {
    text-align: center;
    margin: 20px 0;
}

.product-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.product {
    background: white;
    padding: 15px;
    text-align: center;
    border: 1px solid #ddd;
    width: 200px;
}

#cart {
    text-align: center;
    margin: 20px;
    padding: 20px;
    background: white;
    border: 1px solid #ddd;
}

form {
    display: flex;
    flex-direction: column;
    max-width: 400px;
    margin: auto;
}

form input, form textarea, form button {
    margin-bottom: 10px;
    padding: 10px;
}

@media (max-width: 768px) {
    .product-list {
        flex-direction: column;
        align-items: center;
    }

    .product {
        width: 90%;
    }
}
